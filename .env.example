# ─── Wallet ─────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...      # bscTestnet / local only
LEDGER_ACCOUNT_MAINNET=0x...    # bscMainnet: Ledger address (m/44'/60'/0'/0/0), not a key

# ─── RPC / explorer ─────────────────────────────────────────────────────────
BSC_RPC_MAINNET=https://bsc-dataseed1.binance.org
BSC_RPC_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545
BSCSCAN_API_KEY=

# Gas reporter (optional)
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ─── Deploy ─────────────────────────────────────────────────────────────────
# Contract addresses are resolved from deployments/<network>/, not from here.
# Only wallets / config live in .env.

# ReferralRegistry (01)
REFER_ROOT=                   # root referrer

# ENCVesting (02) — fresh deploy only
ENC_VESTING_TEAM_WALLET=      # 450,000,000 ENC
ENC_VESTING_TREASURY_WALLET=  # 1,520,000,000 ENC
ENC_VESTING_PUBLIC_WALLET=    # 990,000,000 ENC; also granted OPERATOR_ROLE on EnishiPublicSale (02d) and ENCVesting (Wire)

# ENCLock (03) + ENCCommission (04)
ENISHI_MASTER_WALLET=         # operating + CSR fees

# Vault (08)
FUND_WALLET=

# EnishiPublicSale (02d)
BSC_USDT=                     # set per network: EnishiAddresses.sol's BSC_USDT
                               # on mainnet, EnishiAddressesTestnet.sol's on testnet
                               # treasury (USDT destination) = ENISHI_MASTER_WALLET above

# ─── SEOA (10 GenerateSEOAs / 11 RegisterSEOAs) ─────────────────────────────
SEOA_MNEMONIC=                # BIP-39 seed phrase; never written to the output file
SEOA_HD_INDEX=0               # start index; use 300, 600… for later batches
SEOA_COUNT=300
SEOA_OUTPUT=./swc-config.json # gitignored; 11 reads it back
SEOA_BATCH_SIZE=50            # addresses per registerSEOAs tx
